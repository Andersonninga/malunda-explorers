# MALUNDA EXPLORERS — Environment Configuration Example
# Copy this file to .env and configure for your deployment environment

# Server Port
PORT=3000

# Environment Mode (development / production)
NODE_ENV=production

# Application Domain & Base URL
APP_URL=https://malundaexplorers.com

# Currency & Booking Defaults
DEFAULT_CURRENCY=USD
DEFAULT_DEPOSIT_PERCENTAGE=30

# Company Contact Information (Overrides JSON site_settings if provided)
COMPANY_PHONE=+255784567890
COMPANY_WHATSAPP=+255784567890
COMPANY_EMAIL=info@malundaexplorers.com
COMPANY_RESERVATIONS_EMAIL=reservations@malundaexplorers.com

# Payment Provider Integration Credentials (Sandbox / Production)
# Configure when ready to activate live payment processing in Tanzania

# 1. Stripe (Card Checkout)
STRIPE_PUBLISHABLE_KEY=pk_test_sample_placeholder
STRIPE_SECRET_KEY=sk_test_sample_placeholder
STRIPE_WEBHOOK_SECRET=whsec_sample_placeholder

# 2. Pesapal East Africa (Visa, MasterCard, M-Pesa, Airtel Money)
PESAPAL_CONSUMER_KEY=pesapal_consumer_key_placeholder
PESAPAL_CONSUMER_SECRET=pesapal_consumer_secret_placeholder
PESAPAL_ENV=sandbox

# 3. Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-sample-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-sample-X
FLUTTERWAVE_SECRET_HASH=sample_webhook_hash

# 4. Bank Wire Proforma Instructions (CRDB Bank Arusha, Tanzania)
BANK_ACCOUNT_NAME=Malunda Explorers Ltd
BANK_NAME=CRDB Bank Plc
BANK_BRANCH=Clocktower Branch, Arusha, Tanzania
BANK_ACCOUNT_NUMBER=0150XXXXXXXXX
BANK_SWIFT_CODE=CORUTZTZ

# Email Dispatch Configuration (SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@malundaexplorers.com
SMTP_PASS=sample_smtp_password
SMTP_FROM="Malunda Explorers Reservations <reservations@malundaexplorers.com>"
